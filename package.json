{
  "name": "burn-rate-meter",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project=chromium",
    "brand-assets": "BRAND_ASSETS=1 playwright test e2e/brand-assets.spec.ts --project=chromium"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "motion": "^13.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.93.0",
    "stylelint": "^17.15.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "homepage": "https://ubongfx.github.io/burn-rate-meter/"
}
